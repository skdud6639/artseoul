# Public submissions remain disabled until all required settings are supplied.
# Never put ADMIN_TOKEN into a VITE_* variable or commit a real .env file.
INQUIRY_ENABLED=false
INQUIRY_OPERATOR=
INQUIRY_PRIVACY_CONTACT=
# Set a real, approved retention period (1 to 3650 days).
INQUIRY_RETENTION_DAYS=
# Generate a private random value of at least 32 characters.
ADMIN_TOKEN=
# Use a persistent volume outside public/ and dist/ in production.
INQUIRY_DATABASE_PATH=.data/inquiries.sqlite
# Required behind an HTTPS reverse proxy; exact public origin without trailing slash.
PUBLIC_ORIGIN=

# Optional: exact reverse-proxy IPv4/IPv6 addresses, comma-separated.
# No CIDR ranges, wildcards, or blanket trust. Leave blank for direct connections.
# X-Forwarded-For is ignored unless the connecting proxy is explicitly trusted.
# Your proxy must append/replace forwarded headers with the actual client address.
TRUSTED_PROXY_IPS=
